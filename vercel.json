{
  "buildCommand": "git clone https://github.com/mehCake/luraph-deobfuscator-py.git luraph-deobfuscator-py",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "public/index.html"
    }
  ]
}
